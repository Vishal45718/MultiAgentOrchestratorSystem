# Application / Environment
ENVIRONMENT=development
APP_NAME=MultiAgentOrchestrationSystem
DEBUG=false
LOG_LEVEL=INFO

# Service Ports & Hosts
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orchestrator
# Optional: Override direct database connection string
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orchestrator

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional: Override direct Redis connection string
# REDIS_URL=redis://localhost:6379/0

# Celery (defaults to Redis connection if omitted)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000
# CHROMA_PERSIST_DIR=

# LLM Providers (Do NOT commit real API keys or credentials)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
